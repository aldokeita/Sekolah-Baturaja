# Salin berkas ini menjadi backend/.env, lalu isi tiga nilai yang wajib.
# Berkas .env tidak ikut masuk git — aman untuk menyimpan rahasia di sana.

# ── WAJIB DIISI ──────────────────────────────────────────────────────────────

# Sandi database. Dipakai dua kali: sebagai sandi container Postgres, dan untuk
# menyusun DATABASE_URL yang dipakai API. Kalau kosong, `docker compose up`
# gagal sebelum apa pun berjalan.
POSTGRES_PASSWORD=ganti_dengan_sandi_acak

# Dua kunci penanda sesi login. Harus acak, minimal 32 karakter, dan HARUS
# berbeda satu dengan yang lain. Backend berhenti kalau salah satu kosong.
# Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti_dengan_string_acak_32_byte
JWT_REFRESH_SECRET=ganti_dengan_string_acak_lain_32_byte

# Alamat situs yang boleh memanggil API ini. Tanpa garis miring di akhir.
# Salah mengisi ini membuat setiap login gagal tanpa pesan yang jelas di browser.
# Boleh beberapa alamat, dipisah koma.
#   lokal    : http://localhost:3000
#   produksi : https://sekolahmu.sch.id
CORS_ORIGIN=http://localhost:3000

# ── OPSIONAL (nilai bawaan sudah benar untuk sebagian besar pemasangan) ───────

# DATABASE_URL diisi otomatis oleh docker-compose; jangan disetel di sini.

# PORT=8080
# ACCESS_TOKEN_TTL_MINUTES=60
# REFRESH_TOKEN_TTL_DAYS=30
# UPLOAD_DIR=/app/uploads
# MAX_UPLOAD_MB=20

# ── NOTIFIKASI WHATSAPP (opsional) ─────────────────────────────────────

# Tanpa token, seluruh notifikasi WA mati dan aplikasi berperilaku normal.
# Token didapat dari perangkat gateway (mis. akun Fonnte sekolah): dashboard
# Fonnte → My Devices → kunci token. URL bawaan sudah menunjuk ke API Fonnte.
# WA_GATEWAY_URL=https://api.fonnte.com/send
# WA_GATEWAY_TOKEN=ganti_dengan_token_perangkat_gateway
