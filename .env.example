# URL backend Go (ubah ke domain/IP VPS saat deploy)
VITE_API_URL=http://localhost:8080

# Fitur opsional
VITE_ENABLE_EDGE_FUNCTIONS=false
VITE_ENABLE_DEFERRED_FEATURES=false
# Program tahfizh opsional. Set true bila sekolah menjalankannya.
VITE_ENABLE_TAHFIZH=false

# Papan Materi, Tugas & Pengumuman kelas untuk guru. Mati untuk SD — guru
# mengabari orang tua lewat grup WhatsApp. Set true bila dipakai (mis. SMP/SMA).
VITE_ENABLE_KELAS_KONTEN=false

# Notifikasi WhatsApp otomatis. Perlu layanan gerbang WhatsApp berbayar DAN
# migrasi supabase/migrations/20260823000100_wa_outbox.sql diterapkan lebih dulu.
VITE_ENABLE_WA_NOTIFICATIONS=false
